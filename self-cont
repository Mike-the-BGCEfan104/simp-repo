import os
import subprocess
import shutil

REPO_URL = "https://github.com/Mike-the-BGCEfan104/simp-repo"
DEST_DIR = "mi-servidor-clonado"
ENV_EXAMPLE = ".env.example"
ENV_REAL = ".env"

def run_command(command, description):
    print(f"[*] {description}...")
    try:
        subprocess.run(command, check=True, shell=True)
    except subprocess.CalledProcessError as e:
        print(f"[!] Error en: {description}. Detalles: {e}")
        exit(1)

def setup():
    print("=== INICIANDO DESPLIEGUE DEL SERVIDOR ===\n")

    if not os.path.exists(DEST_DIR):
        run_command(f"git clone {REPO_URL} {DEST_DIR}", "Clonando del repositorio en proceso.")
    else:
        print("[!] El directorio de destino ya existe. Omitiendo clonación.")

    os.chdir(DEST_DIR)

    if not os.path.exists(ENV_REAL):
        if os.path.exists(ENV_EXAMPLE):
            shutil.copy(ENV_EXAMPLE, ENV_REAL)
            print("[+] Archivo .env creado. Recuerde editarlo.")
        else:
            with open(ENV_REAL, "w") as f:
                f.write("DB_USER=admin\nDB_PASS=cambiame\nPORT=8080")
            print("[+] Archivo .env generado desde cero.")

    run_command("pip install -r requirements.txt", "Instalando dependencias.")

    run_command("chmod +x *.sh", "Dando permisos de ejecución a scripts.")

    print("\n[OK] Configuración completada con éxito.")
    print(f"Próximo paso: edite {DEST_DIR}/{ENV_REAL} y arranque el servidor.")

if __name__ == "__main__":
    setup()




def setup_watchdog_instant_sync():
    print("\n=== Configurando clonación instantánea utilizando un watchdog ===")
    
    try:
        subprocess.run(["apt-get", "update", "-qq"], check=True)
        subprocess.run(["apt-get", "install", "-y", "rsync", "python3-pip"], check=True)
        subprocess.run(["pip3", "install", "--upgrade", "watchdog"], check=True)

        
        subprocess.run(["cp", "/root/simp-repo/instant_sync.py", "/usr/local/bin/instant-sync"], check=True)
        subprocess.run(["chmod", "+x", "/usr/local/bin/instant-sync"], check=True)

        print("Clonación instantánea configurada correctamente.")
        print("\nComandos disponibles:")
        print("   instant-sync init      → Primera sincronización completa")
        print("   instant-sync start     → Iniciar sincronización en tiempo real")
        print("\nRecomendación: Ejecutar 'instant-sync start' dentro de screen o tmux.")
    except Exception as e:
        print(f"Error al configurar sincronización instantánea: {e}")


# Llamada final
if __name__ == "__main__":


    setup_watchdog_instant_sync() #Realmente el que ejecuta
